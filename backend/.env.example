# Student Project Showcase API - Environment Configuration (Phase 1)
# Copy this file to .env and adjust variables as needed.

# Application Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Database Configuration
# Default: PostgreSQL for local container / managed cloud instance
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/showcase_db
# Optional local fallback if PostgreSQL is unavailable:
# DATABASE_URL=sqlite:///./showcase.db

# CORS Configuration (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Future Cloud Storage Settings (Phase 2 Preparation)
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=student-project-showcase-assets
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
